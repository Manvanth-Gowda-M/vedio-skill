{
  "$id": "https://creatorflow.local/schemas/planning-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "planning-run"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sessionRevision": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sessionFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "weekId": {
      "type": "string"
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "scoringModel": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "profileFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "historyWeeks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "ranking": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "contentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "topic": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "news",
              "explainer",
              "tutorial",
              "comparison",
              "experiment",
              "recap"
            ]
          },
          "factors": {
            "type": "object",
            "properties": {
              "freshness": {
                "type": "object",
                "properties": {
                  "score": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "score",
                  "detail"
                ],
                "additionalProperties": false
              },
              "relevance": {
                "type": "object",
                "properties": {
                  "score": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "score",
                  "detail"
                ],
                "additionalProperties": false
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "score": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "score",
                  "detail"
                ],
                "additionalProperties": false
              },
              "originality": {
                "type": "object",
                "properties": {
                  "score": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "score",
                  "detail"
                ],
                "additionalProperties": false
              },
              "feasibility": {
                "type": "object",
                "properties": {
                  "score": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "score",
                  "detail"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "freshness",
              "relevance",
              "evidence",
              "originality",
              "feasibility"
            ],
            "additionalProperties": false
          },
          "missingFactors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "eligible": {
            "type": "boolean"
          },
          "rejections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "platform": {
            "type": "string",
            "enum": [
              "youtube-long",
              "youtube-shorts",
              "instagram-reels",
              "tiktok",
              "linkedin-video"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
          },
          "durationSec": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "newestEvidenceDate": {
            "type": "string"
          }
        },
        "required": [
          "candidateId",
          "contentId",
          "topic",
          "category",
          "factors",
          "missingFactors",
          "score",
          "eligible",
          "rejections",
          "warnings",
          "rationale",
          "effort",
          "platform",
          "language",
          "durationSec"
        ],
        "additionalProperties": false
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "candidateId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "contentId",
          "candidateId",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "notSelected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "candidateId",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "shortfall": {
      "type": "object",
      "properties": {
        "target": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "selected": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "eligible": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "selected",
        "eligible",
        "message"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "unchanged"
          ]
        }
      },
      "required": [
        "version",
        "contentHash",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "sessionId",
    "sessionRevision",
    "sessionFingerprint",
    "weekId",
    "asOf",
    "createdAt",
    "scoringModel",
    "weights",
    "profileFingerprint",
    "configFingerprint",
    "historyWeeks",
    "target",
    "ranking",
    "selected",
    "notSelected",
    "plan"
  ],
  "additionalProperties": false
}
