{
  "$id": "https://creatorflow.local/schemas/subtitle-tracks.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "subtitle-tracks"
    },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "script": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "tracks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
          },
          "timing": {
            "type": "string",
            "enum": [
              "estimated",
              "sentence-aligned",
              "word-aligned"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "canonical",
              "localized"
            ]
          },
          "cues": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cueId": {
                  "type": "string",
                  "pattern": "^cue-[a-z0-9-]+-\\d{4}$"
                },
                "index": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "lines": {
                  "minItems": 1,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "segmentId": {
                  "type": "string",
                  "pattern": "^seg-\\d{2}-[a-z]+$"
                },
                "sceneId": {
                  "type": "string",
                  "pattern": "^scn-\\d{2}$"
                }
              },
              "required": [
                "cueId",
                "index",
                "startMs",
                "endMs",
                "lines",
                "segmentId"
              ],
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cueId": {
                  "type": "string",
                  "pattern": "^cue-[a-z0-9-]+-\\d{4}$"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "cueId",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "language",
          "timing",
          "source",
          "cues",
          "warnings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "contentId",
    "script",
    "tracks"
  ],
  "additionalProperties": false
}
