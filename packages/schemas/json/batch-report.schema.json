{
  "$id": "https://creatorflow.local/schemas/batch-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "batch-report"
    },
    "weekId": {
      "type": "string",
      "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "approvedBy": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "planned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inProgress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rendered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "qaPassed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewPending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "packaged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "total",
        "planned",
        "inProgress",
        "rendered",
        "qaPassed",
        "reviewPending",
        "reviewed",
        "packaged",
        "blocked",
        "failed"
      ],
      "additionalProperties": false
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "contentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "news",
              "explainer",
              "tutorial",
              "comparison",
              "experiment",
              "recap"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "PLANNED",
              "RESEARCHED",
              "SCRIPTED",
              "LOCALIZED",
              "NARRATED",
              "ASSETS_READY",
              "RENDER_QUEUED",
              "RENDERED",
              "QA_PASSED",
              "REVIEWED",
              "PACKAGE_READY",
              "BLOCKED",
              "FAILED"
            ]
          },
          "currentStep": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastSuccessfulStep": {
            "type": [
              "string",
              "null"
            ]
          },
          "stepsCompleted": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stepsReused": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocked": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "step",
              "code",
              "reason"
            ],
            "additionalProperties": false
          },
          "failure": {
            "type": "object",
            "properties": {
              "step": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "step",
              "kind",
              "code",
              "message"
            ],
            "additionalProperties": false
          },
          "qaVerdict": {
            "default": "none",
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "pending",
              "none"
            ]
          },
          "reviewStatus": {
            "default": "none",
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "not-required",
              "pending",
              "none"
            ]
          },
          "packageStatus": {
            "default": "none",
            "type": "string",
            "enum": [
              "packaged",
              "missing",
              "corrupt",
              "none"
            ]
          },
          "packagePath": {
            "type": "string",
            "minLength": 1
          },
          "packageManifestSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "pendingApproval": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "plan",
                  "review"
                ]
              },
              "requiredHash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "instructions": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "requiredHash",
              "instructions"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "jobId",
          "contentId",
          "title",
          "category",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "weekId",
    "generatedAt",
    "plan",
    "summary",
    "jobs"
  ],
  "additionalProperties": false
}
