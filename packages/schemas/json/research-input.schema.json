{
  "$id": "https://creatorflow.local/schemas/research-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sessionTopic": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "official-documentation",
              "official-announcement",
              "changelog",
              "repository",
              "paper",
              "reputable-reporting",
              "community",
              "user-notes",
              "other"
            ]
          },
          "otherDescription": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "modifiedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "retrievedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "snapshot": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "maxLength": 10000
          },
          "confidenceNotes": {
            "type": "string",
            "maxLength": 2000
          },
          "attribution": {
            "type": "string",
            "maxLength": 500
          },
          "usageRestrictions": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        },
        "required": [
          "key",
          "title",
          "sourceType"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "interpretation",
              "hypothesis"
            ]
          },
          "evidence": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "kind": {
                  "default": "quote",
                  "type": "string",
                  "enum": [
                    "quote",
                    "paraphrase"
                  ]
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1500
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "key",
          "text",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "candidates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "topic": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": [
              "news",
              "explainer",
              "tutorial",
              "comparison",
              "experiment",
              "recap"
            ]
          },
          "workingTitle": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "audienceProblem": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "angle": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "hook": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "takeaway": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          },
          "claims": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "breaking": {
            "default": false,
            "type": "boolean"
          },
          "platform": {
            "type": "string",
            "enum": [
              "youtube-long",
              "youtube-shorts",
              "instagram-reels",
              "tiktok",
              "linkedin-video"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
          },
          "durationSec": {
            "type": "integer",
            "minimum": 5,
            "maximum": 7200
          },
          "requiredAssets": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "key",
          "topic",
          "category",
          "claims"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
