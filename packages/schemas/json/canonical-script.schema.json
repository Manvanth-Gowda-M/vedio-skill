{
  "$id": "https://creatorflow.local/schemas/canonical-script.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "canonical-script"
    },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
    },
    "format": {
      "type": "string",
      "enum": [
        "short-explainer",
        "tutorial",
        "news-update",
        "comparison",
        "evergreen-explainer",
        "long-explainer"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "deterministic": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "version",
        "deterministic"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "weekId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "itemHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "weekId",
        "version",
        "contentHash",
        "itemHash"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidenceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256",
        "evidenceHash"
      ],
      "additionalProperties": false
    },
    "evidenceAsOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "title": {
      "type": "string",
      "maxLength": 150
    },
    "platform": {
      "type": "string",
      "enum": [
        "youtube-long",
        "youtube-shorts",
        "instagram-reels",
        "tiktok",
        "linkedin-video"
      ]
    },
    "aspectRatio": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5"
      ]
    },
    "targetDurationSec": {
      "type": "integer",
      "minimum": 5,
      "maximum": 9007199254740991
    },
    "estimatedDurationSec": {
      "type": "number",
      "minimum": 0
    },
    "timingStatus": {
      "type": "string",
      "const": "estimated"
    },
    "speechRateWpm": {
      "type": "number",
      "minimum": 40,
      "maximum": 400
    },
    "segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "pattern": "^seg-\\d{2}-[a-z]+$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "hook",
              "context",
              "explanation",
              "demonstration",
              "takeaway",
              "outro"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
          },
          "narration": {
            "type": "string",
            "maxLength": 2000
          },
          "onScreenText": {
            "type": "string",
            "maxLength": 200
          },
          "textOrigin": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "claim",
                "template",
                "plan",
                "source"
              ]
            }
          },
          "claimRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claimId": {
                  "type": "string",
                  "pattern": "^clm-[a-z0-9-]+$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "fact",
                    "interpretation",
                    "hypothesis"
                  ]
                },
                "support": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "supported-unchecked",
                    "weak",
                    "unsupported",
                    "interpretation",
                    "hypothesis"
                  ]
                },
                "usage": {
                  "type": "string",
                  "enum": [
                    "state-as-fact-with-citation",
                    "state-as-fact-cite-and-verify",
                    "present-as-opinion",
                    "present-as-question"
                  ]
                },
                "sourceIds": {
                  "minItems": 0,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "claimId",
                "kind",
                "support",
                "usage",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "words": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "estimatedSec": {
                "type": "number",
                "minimum": 0
              },
              "minSec": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "words",
              "estimatedSec",
              "minSec"
            ],
            "additionalProperties": false
          },
          "visual": {
            "type": "object",
            "properties": {
              "sceneType": {
                "type": "string",
                "enum": [
                  "hook-typography",
                  "title-intro",
                  "concept-explanation",
                  "technical-diagram",
                  "code-terminal-demo",
                  "comparison-layout",
                  "screen-capture",
                  "source-quote",
                  "summary",
                  "outro"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "emphasis": {
                "default": [],
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            },
            "required": [
              "sceneType",
              "description"
            ],
            "additionalProperties": false
          },
          "transition": {
            "type": "string",
            "enum": [
              "cut",
              "fade",
              "slide",
              "none"
            ]
          },
          "editorialNotes": {
            "default": [],
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": [
          "segmentId",
          "purpose",
          "language",
          "narration",
          "onScreenText",
          "textOrigin",
          "claimRefs",
          "sourceRefs",
          "timing",
          "visual",
          "transition",
          "optional"
        ],
        "additionalProperties": false
      }
    },
    "attributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "requiredText": {
            "type": "string"
          },
          "usageRestrictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "segmentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^seg-\\d{2}-[a-z]+$"
            }
          }
        },
        "required": [
          "sourceId",
          "title",
          "usageRestrictions",
          "segmentIds"
        ],
        "additionalProperties": false
      }
    },
    "droppedSegments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segmentId": {
            "type": "string",
            "pattern": "^seg-\\d{2}-[a-z]+$"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "segmentId",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "editorial": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "duration-shortfall",
            "over-duration"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "message": {
                "type": "string",
                "maxLength": 1000
              },
              "segmentId": {
                "type": "string",
                "pattern": "^seg-\\d{2}-[a-z]+$"
              }
            },
            "required": [
              "severity",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "issues"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "contentId",
    "jobId",
    "language",
    "format",
    "provider",
    "plan",
    "evidence",
    "evidenceAsOf",
    "title",
    "platform",
    "aspectRatio",
    "targetDurationSec",
    "estimatedDurationSec",
    "timingStatus",
    "speechRateWpm",
    "segments",
    "attributions",
    "droppedSegments",
    "editorial"
  ],
  "additionalProperties": false
}
