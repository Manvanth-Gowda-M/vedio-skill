{
  "$id": "https://creatorflow.local/schemas/package-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "package-manifest"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "weekId": {
      "type": "string",
      "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "planHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "itemHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "planHash",
        "itemHash"
      ],
      "additionalProperties": false
    },
    "packagedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "delivery": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "packaged"
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "news",
            "explainer",
            "tutorial",
            "comparison",
            "experiment",
            "recap"
          ]
        },
        "primaryLanguage": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
        },
        "platform": {
          "type": "string",
          "enum": [
            "youtube-long",
            "youtube-shorts",
            "instagram-reels",
            "tiktok",
            "linkedin-video"
          ]
        },
        "durationSec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "category",
        "primaryLanguage",
        "platform",
        "durationSec"
      ],
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "properties": {
        "reportSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "technicalQa": {
          "type": "string",
          "const": "passed"
        }
      },
      "required": [
        "reportSha256",
        "technicalQa"
      ],
      "additionalProperties": false
    },
    "review": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "approved"
            },
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "note": {
              "type": "string"
            },
            "decisionSha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "status",
            "by",
            "at",
            "decisionSha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "not-required"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "role": {
            "type": "string",
            "enum": [
              "video",
              "subtitles",
              "thumbnail",
              "script",
              "storyboard",
              "sceneManifest",
              "attribution",
              "provenance",
              "renderReport",
              "qaReport",
              "reviewRecord",
              "reviewDecision",
              "manifest",
              "other"
            ]
          },
          "contentType": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "role",
          "contentType"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "role",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "jobId",
    "contentId",
    "weekId",
    "plan",
    "packagedAt",
    "delivery",
    "metadata",
    "qa",
    "review",
    "files"
  ],
  "additionalProperties": false
}
