          "contentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "topic": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "news",
              "explainer",
              "tutorial",
              "comparison",
              "experiment",
              "recap"
            ]
          },
          "workingTitle": {
            "type": "string"
          },
          "audienceProblem": {
            "type": "string"
          },
          "angle": {
            "type": "string"
