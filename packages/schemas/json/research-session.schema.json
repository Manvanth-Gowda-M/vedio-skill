          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "interpretation",
              "hypothesis"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "quote",
                    "paraphrase"
                  ]
                },
                "excerpt": {
                  "type": "string"
                },
                "locator": {
                  "type": "string"
                },
                "check": {
                  "type": "string",
                  "enum": [
                    "found-in-snapshot",
                    "not-found-in-snapshot",
                    "not-checked"
                  ]
                }
              },
              "required": [
                "sourceId",
                "kind",
                "check"
              ],
              "additionalProperties": false
            }
