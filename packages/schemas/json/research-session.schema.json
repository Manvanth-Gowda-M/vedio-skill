            "additionalProperties": false
          }
        },
        "required": [
          "at",
          "provider",
          "inputs",
          "inputHash",
          "mode",
          "counts"
        ],
        "additionalProperties": false
      }
    },
    "lastImportIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "record": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "severity",
          "record",
          "path",
          "message"
        ],
        "additionalProperties": false
      }
