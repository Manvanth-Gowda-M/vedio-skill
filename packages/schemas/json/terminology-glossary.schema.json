{
  "$id": "https://creatorflow.local/schemas/terminology-glossary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "terminology-glossary"
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "product",
              "technical",
              "brand",
              "other"
            ]
          },
          "doNotTranslate": {
            "type": "boolean"
          },
          "pronunciation": {
            "type": "string"
          },
          "preferred": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "term",
          "category",
          "doNotTranslate",
          "preferred"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "terms"
  ],
  "additionalProperties": false
}
