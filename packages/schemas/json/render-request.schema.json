{
  "$id": "https://creatorflow.local/schemas/render-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "render-request"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "contentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "weekId": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "weekId",
        "version",
        "contentHash"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "storyboard": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "captions": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "assetResolution": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "narration": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "subtitles": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "manifest",
        "storyboard",
        "captions",
        "assetResolution"
      ],
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 240,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 120
        },
        "durationInFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "durationInFrames"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "const": "h264"
        },
        "crf": {
          "type": "integer",
          "minimum": 1,
          "maximum": 51
        },
        "pixelFormat": {
          "type": "string",
          "enum": [
            "yuv420p",
            "yuv444p"
          ]
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "captions": {
          "type": "string",
          "enum": [
            "burn-in",
            "off"
          ]
        },
        "chromeMode": {
          "type": "string",
          "enum": [
            "headless-shell",
            "chrome-for-testing"
          ]
        }
      },
      "required": [
        "codec",
        "crf",
        "pixelFormat",
        "concurrency",
        "captions",
        "chromeMode"
      ],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "creatorflow-remotion"
        },
        "version": {
          "type": "string"
        },
        "remotion": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "remotion"
      ],
      "additionalProperties": false
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationInFrames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "fallback": {
            "type": "string",
            "enum": [
              "none",
              "text-only"
            ]
          }
        },
        "required": [
          "sceneId",
          "type",
          "component",
          "startFrame",
          "durationInFrames",
          "fallback"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "string",
          "enum": [
            "none",
            "narration"
          ]
        },
        "file": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "sampleRate": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "channels": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path",
            "sha256",
            "durationMs",
            "sampleRate",
            "channels"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "expected"
      ],
      "additionalProperties": false
    },
    "captionsTiming": {
      "type": "string",
      "enum": [
        "estimated",
        "sentence-aligned",
        "word-aligned"
      ]
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "pattern": "^ast-[a-z0-9-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          },
          "endSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fit": {
            "type": "string",
            "enum": [
              "contain",
              "cover"
            ]
          },
          "playSec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "holdSec": {
            "type": "number",
            "minimum": 0
          },
          "sourceAudio": {
            "type": "string",
            "enum": [
              "none",
              "muted"
            ]
          }
        },
        "required": [
          "sceneId",
          "assetId",
          "sha256",
          "startSec",
          "endSec",
          "fit",
          "playSec",
          "holdSec",
          "sourceAudio"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "jobId",
    "contentId",
    "plan",
    "inputs",
    "format",
    "settings",
    "renderer",
    "scenes",
    "warnings"
  ],
  "additionalProperties": false
}
